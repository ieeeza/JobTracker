<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate
        x:Key="BarTemplate">
        <Grid
            Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="145" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="35" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{Binding Label}"
                VerticalAlignment="Center" />
            <Border
                Grid.Column="1"
                Background="{DynamicResource AccentSoftBrush}"
                Height="14"
                CornerRadius="7">
                <Border
                    Background="{DynamicResource AccentBrush}"
                    Width="{Binding Width}"
                    HorizontalAlignment="Left"
                    CornerRadius="7" />
            </Border>
            <TextBlock
                Grid.Column="2"
                Text="{Binding Count}"
                HorizontalAlignment="Right" />
        </Grid>
    </DataTemplate>
    <DataTemplate
        x:Key="JobCard">
        <StackPanel
            Margin="4">
            <TextBlock
                Text="{Binding Content.Title}"
                FontSize="16"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                Text="{Binding Content.Company}"
                Margin="0,5" />
            <TextBlock
                Text="{Binding Content.Technologies}"
                Style="{StaticResource Muted}" />
            <WrapPanel
                Margin="0,8,0,0">
                <TextBlock
                    Text="{Binding StatusLabel}"
                    Foreground="{DynamicResource AccentBrush}"
                    Margin="0,0,14,0" />
                <TextBlock
                    Text="{Binding Content.Location}"
                    Style="{StaticResource Muted}" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
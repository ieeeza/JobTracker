<UserControl
    x:Class="JobTracker.Presentation.Views.Imports.PdfImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource TextBrush}">
    <StackPanel Background="{DynamicResource BackgroundBrush}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Importar PDF" Style="{StaticResource Heading}" />
                <TextBlock
                    Text="Extraia o texto e analise uma vaga com o Qwen local. Confira as sugestões antes de utilizá-las."
                    Style="{StaticResource Muted}"
                    Margin="0,0,0,16" />
                <WrapPanel>
                    <Button
                        Content="Selecionar PDF"
                        Command="{Binding SelectPdfCommand}" />
                    <Button
                        Content="Extrair texto"
                        Command="{Binding ExtractPdfCommand}" />
                    <Button
                        Content="Analisar com IA"
                        Command="{Binding AnalyzePdfCommand}" />
                    <Button
                        Content="Cancelar"
                        Command="{Binding CancelPdfCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                </WrapPanel>
                <TextBlock Text="Documento" FontWeight="SemiBold" Margin="0,8,0,4" />
                <TextBlock
                    Text="{Binding SelectedPdfPath, TargetNullValue=Nenhum PDF selecionado.}"
                    Style="{StaticResource Muted}" />
                <ProgressBar
                    IsIndeterminate="{Binding IsBusy}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    Height="4"
                    Margin="0,16,0,8"
                    Foreground="{DynamicResource AccentBrush}"
                    Background="{DynamicResource SurfaceBrush}"
                    AutomationProperties.Name="Processamento do PDF em andamento" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    Style="{StaticResource Muted}"
                    Margin="0,12,0,0"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Texto extraído" Style="{StaticResource Heading}" />
                <TextBox
                    Text="{Binding ExtractedText, Mode=OneWay}"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Height="220"
                    AutomationProperties.Name="Texto original do PDF" />
            </StackPanel>
        </Border>

        <Border
            Style="{StaticResource Card}"
            Visibility="{Binding HasAnalysis, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <TextBlock Text="Dados identificados pela IA" Style="{StaticResource Heading}" />
                <TextBlock
                    Text="Revise e corrija os dados antes de salvar. Cargo e empresa são obrigatórios; a URL é opcional. A vaga será cadastrada com status Salva."
                    Style="{StaticResource Muted}"
                    Margin="0,0,0,16" />
                <StackPanel IsEnabled="{Binding CanEditDraft}">
                    <TextBlock Text="Cargo *" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Cargo identificado no PDF" />
                    <TextBlock Text="Empresa *" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Empresa identificada no PDF" />
                    <TextBlock Text="Localização" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Localização identificada no PDF" />
                    <TextBlock Text="Modalidade" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.WorkMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Modalidade identificada no PDF" />
                    <TextBlock Text="Senioridade" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Seniority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Senioridade identificada no PDF" />
                    <TextBlock Text="Contratação e jornada" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Contract, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Contratação identificada no PDF" />
                    <TextBlock Text="Remuneração" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Salary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Remuneração identificada no PDF" />
                    <TextBlock Text="URL da vaga" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="URL identificada no PDF" />
                    <TextBlock Text="Requisitos obrigatórios e desejáveis" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Requirements, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        MaxHeight="220"
                        AutomationProperties.Name="Requisitos identificados no PDF" />
                    <TextBlock Text="Tecnologias" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Technologies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Tecnologias identificadas no PDF" />
                    <TextBlock Text="Descrição, responsabilidades e benefícios" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Draft.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Height="220"
                        AutomationProperties.Name="Descrição identificada no PDF" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding AnalysisResult.Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding}"
                                Style="{StaticResource Muted}"
                                Margin="0,4,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                    Content="Salvar vaga"
                    Command="{Binding SavePdfCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0"
                    AutomationProperties.Name="Salvar vaga do PDF" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    Style="{StaticResource Muted}"
                    Margin="0,8,0,0"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

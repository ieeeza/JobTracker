<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:JobTracker.Presentation"
    x:Class="JobTracker.Presentation.Views.SettingsView">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="900"
            HorizontalAlignment="Left">
            <Border
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Text="Inteligência artificial local — Ollama"
                        Style="{StaticResource Heading}" />
                    <TextBlock
                        Text="Instale qwen3-vl:8b no Ollama local. O JobTracker não instala modelos nem inicia o Ollama. As imagens são enviadas somente para este computador."
                        Style="{StaticResource Muted}" />
                    <TextBlock
                        Text="Endereço do servidor local"
                        Margin="0,12,0,0" />
                    <TextBox
                        Text="{Binding Ollama.BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="200"
                        AutomationProperties.Name="Endereço local do Ollama" />
                    <TextBlock
                        Text="Modelo" />
                    <TextBox
                        Text="{Binding Ollama.Model, UpdateSourceTrigger=PropertyChanged}"
                        IsReadOnly="True"
                        MaxLength="200"
                        AutomationProperties.Name="Modelo Ollama" />
                    <CheckBox
                        Content="Aguardar o Ollama concluir, sem limite de tempo"
                        IsChecked="{Binding Ollama.WaitForCompletion}" />
                    <CheckBox
                        Content="Economizar memória na análise individual (recomendado para GPU de 8 GB)"
                        IsChecked="{Binding Ollama.PreferLowMemoryIndividualAnalysis}" />
                    <TextBlock
                        Text="Ativado por padrão: processa uma captura por vez, limita o contexto a 4096 tokens e evita repetições com contexto maior. Preserva a resolução original. Capturas muito extensas podem exigir recortes ou desativar esta opção."
                        Style="{StaticResource Muted}" />
                    <TextBlock
                        Text="Você pode cancelar a análise a qualquer momento. Falhas de memória ou encerramento pelo próprio Ollama ainda podem interromper a geração."
                        Style="{StaticResource Muted}" />
                    <TextBlock
                        Text="Tempo limite quando a espera sem limite estiver desmarcada (10 a 3600 segundos; padrão 300)" />
                    <TextBox
                        Text="{Binding Ollama.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="4"
                        Width="140"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        Text="Manter modelo carregado (0–3600 segundos)" />
                    <TextBox
                        Text="{Binding Ollama.KeepAliveSeconds, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="4"
                        Width="140"
                        HorizontalAlignment="Left" />
                    <Expander
                        Header="Limites de imagens e memória"
                        Margin="0,8">
                        <StackPanel>
                            <TextBlock
                                Text="Contexto inicial em tokens (2048–32768; padrão 8192)" />
                            <TextBox
                                Text="{Binding Ollama.ContextTokens, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="5"
                                AutomationProperties.Name="Contexto do Ollama em tokens" />
                            <TextBlock
                                Text="Contexto máximo para expansão automática (até 262144; padrão 32768)" />
                            <TextBox
                                Text="{Binding Ollama.MaxContextTokens, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="6"
                                AutomationProperties.Name="Contexto máximo do Ollama em tokens" />
                            <TextBlock
                                Text="Na análise individual, a expansão só ocorre com a economia de memória desativada. Mais contexto exige mais memória e pode tornar a análise muito mais lenta. Estes valores valem apenas para o JobTracker."
                                Style="{StaticResource Muted}" />
                            <TextBlock
                                Text="Imagens por lote (1–10; padrão 3)" />
                            <TextBox
                                Text="{Binding Ollama.BatchSize, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="2" />
                            <TextBlock
                                Text="Máximo de imagens por análise (1–100; padrão 30)" />
                            <TextBox
                                Text="{Binding Ollama.MaxImages, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="3" />
                            <TextBlock
                                Text="Máximo de MB de imagens por lote (1–64; padrão 24)" />
                            <TextBox
                                Text="{Binding Ollama.BatchMegabytes, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="2" />
                            <TextBlock
                                Text="Máximo de megapixels por lote (0.01–64; padrão 24; ponto decimal)" />
                            <TextBox
                                Text="{Binding Ollama.BatchMegapixels, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="5" />
                            <TextBlock
                                Text="Os lotes são sequenciais. Base64 e processamento do modelo consomem memória adicional. Os limites gerais de importação continuam valendo. Nenhuma imagem é reduzida automaticamente."
                                Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Expander>
                    <WrapPanel>
                        <Button
                            Content="Salvar configuração Ollama"
                            Command="{Binding Ollama.SaveCommand}"
                            Style="{StaticResource PrimaryButton}" />
                        <Button
                            Content="Verificar conexão"
                            Command="{Binding Ollama.VerifyCommand}" />
                    </WrapPanel>
                    <TextBlock
                        Text="{Binding Ollama.ConnectionStatus}"
                        Style="{StaticResource Muted}"
                        AutomationProperties.LiveSetting="Polite" />
                    <TextBlock
                        Text="A verificação usa os valores acima. Salve para usá-los nas próximas análises; o tempo limite não é uma estimativa de duração."
                        Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
            <Border
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Text="Seu espaço de trabalho"
                        Style="{StaticResource Heading}" />
                    <CheckBox
                        Content="Tema escuro"
                        IsChecked="{Binding Dark}" />
                    <CheckBox
                        Content="Reduzir movimento"
                        IsChecked="{Binding ReduceMotion}" />
                    <Button
                        Content="Salvar preferências"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Text="Dados locais"
                        Style="{StaticResource Heading}" />
                    <TextBlock
                        Text="{Binding DatabasePath}"
                        TextWrapping="Wrap" />
                    <Button
                        Content="Abrir diretório de dados e logs"
                        Command="{Binding OpenFolderCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,12" />
                    <TextBlock
                        Text="JSON inclui dados, histórico e agenda para reimportação. CSV é destinado à consulta em planilhas. A importação mostra uma prévia e nunca substitui registros existentes."
                        Style="{StaticResource Muted}"
                        Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button
                            Content="Exportar JSON"
                            Command="{Binding ExportJsonCommand}" />
                        <Button
                            Content="Exportar CSV"
                            Command="{Binding ExportCsvCommand}" />
                        <Button
                            Content="Importar JSON…"
                            Command="{Binding ImportJsonCommand}" />
                        <Button
                            Content="Importar CSV…"
                            Command="{Binding ImportCsvCommand}" />
                    </WrapPanel>
                    <Separator />
                    <TextBlock
                        Text="O backup SQLite inclui vagas e preferências. A restauração verifica o arquivo e guarda uma cópia de segurança dos dados atuais."
                        Style="{StaticResource Muted}"
                        Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button
                            Content="Criar backup…"
                            Command="{Binding BackupCommand}" />
                        <Button
                            Content="Restaurar backup…"
                            Command="{Binding RestoreCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
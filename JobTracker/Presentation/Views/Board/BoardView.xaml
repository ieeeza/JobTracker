<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:JobTracker.Presentation.Views"
    x:Class="JobTracker.Presentation.Views.BoardView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel>
            <TextBlock
                Text="Mover selecionada para"
                VerticalAlignment="Center"
                Margin="0,0,12,12" />
            <ComboBox
                Width="210"
                ItemsSource="{Binding Statuses}"
                SelectedValuePath="Value"
                DisplayMemberPath="Label"
                SelectedValue="{Binding TargetStatus}" />
            <Button
                Content="Alterar status"
                Command="{Binding ChangeStatusCommand}"
                Style="{StaticResource PrimaryButton}" />
            <Button
                Content="Abrir detalhes"
                Command="{Binding OpenJobCommand}" />
            <TextBlock
                Text="Busca global e filtros da tela Vagas também se aplicam ao quadro."
                Style="{StaticResource Muted}"
                VerticalAlignment="Center" />
        </WrapPanel>
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <ItemsControl
                ItemsSource="{Binding Board}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Style="{StaticResource Card}"
                            Width="270"
                            Padding="12">
                            <DockPanel>
                                <StackPanel
                                    DockPanel.Dock="Top">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontWeight="SemiBold"
                                        FontSize="16" />
                                    <TextBlock
                                        Text="{Binding Jobs.Count, StringFormat={}{0} vagas}"
                                        Style="{StaticResource Muted}"
                                        Margin="0,4,0,12" />
                                </StackPanel>
                                <ListBox
                                    ItemsSource="{Binding Jobs}"
                                    SelectedItem="{Binding DataContext.SelectedJob, RelativeSource={RelativeSource AncestorType={x:Type local:BoardView}}}"
                                    ItemTemplate="{StaticResource JobCard}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
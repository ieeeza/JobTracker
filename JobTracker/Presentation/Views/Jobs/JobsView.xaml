<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:JobTracker.Presentation"
    x:Class="JobTracker.Presentation.Views.JobsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Style="{StaticResource Card}"
            Margin="0,0,0,12"
            Padding="16">
            <WrapPanel>
                <StackPanel
                    Width="170">
                    <TextBlock
                        Text="Empresa" />
                    <TextBox
                        Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Filtrar por empresa" />
                </StackPanel>
                <StackPanel
                    Width="170">
                    <TextBlock
                        Text="Cargo" />
                    <TextBox
                        Text="{Binding RoleFilter, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Filtrar por cargo" />
                </StackPanel>
                <StackPanel
                    Width="150">
                    <TextBlock
                        Text="Tecnologia/tag" />
                    <TextBox
                        Text="{Binding TechnologyFilter, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Filtrar por tecnologia" />
                </StackPanel>
                <StackPanel
                    Width="150">
                    <TextBlock
                        Text="Origem" />
                    <TextBox
                        Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Filtrar por origem" />
                </StackPanel>
                <StackPanel
                    Width="200">
                    <TextBlock
                        Text="Status" />
                    <ComboBox
                        ItemsSource="{Binding Statuses}"
                        DisplayMemberPath="Label"
                        SelectedItem="{Binding StatusFilter}"
                        AutomationProperties.Name="Filtrar por status" />
                </StackPanel>
                <StackPanel
                    Width="160">
                    <TextBlock
                        Text="Criada a partir de" />
                    <DatePicker
                        SelectedDate="{Binding From}"
                        AutomationProperties.Name="Data inicial" />
                </StackPanel>
                <StackPanel
                    Width="160">
                    <TextBlock
                        Text="Criada até" />
                    <DatePicker
                        SelectedDate="{Binding To}"
                        AutomationProperties.Name="Data final" />
                </StackPanel>
                <StackPanel
                    Width="170">
                    <TextBlock
                        Text="Ordenação" />
                    <ComboBox
                        ItemsSource="{Binding Sorts}"
                        SelectedItem="{Binding Sort}"
                        AutomationProperties.Name="Ordenação" />
                </StackPanel>
                <Button
                    Content="Limpar filtros"
                    Command="{Binding Action}"
                    CommandParameter="ClearFilters"
                    VerticalAlignment="Bottom" />
                <CheckBox
                    Content="Visualizar em cards"
                    IsChecked="{Binding Cards}"
                    VerticalAlignment="Bottom" />
            </WrapPanel>
        </Border>
        <TextBlock
            Grid.Row="1"
            Text="{Binding ResultsLabel}"
            Style="{StaticResource Muted}"
            Margin="0,0,0,12" />
        <Grid
            Grid.Row="2">
            <DataGrid
                ItemsSource="{Binding Jobs}"
                SelectedItem="{Binding SelectedJob}"
                AutomationProperties.Name="Lista de vagas">
                <DataGrid.Style>
                    <Style
                        TargetType="DataGrid"
                        BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding Cards}"
                                Value="True">
                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Header="Cargo"
                        Binding="{Binding Content.Title}"
                        Width="2*" />
                    <DataGridTextColumn
                        Header="Empresa"
                        Binding="{Binding Content.Company}"
                        Width="*" />
                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding StatusLabel}"
                        Width="170" />
                    <DataGridTextColumn
                        Header="Candidatura"
                        Binding="{Binding ApplicationLabel}"
                        Width="120" />
                    <DataGridTextColumn
                        Header="Origem"
                        Binding="{Binding Source}"
                        Width="120" />
                </DataGrid.Columns>
            </DataGrid>
            <ListBox
                ItemsSource="{Binding Jobs}"
                SelectedItem="{Binding SelectedJob}"
                ItemTemplate="{StaticResource JobCard}"
                Visibility="{Binding Cards, Converter={StaticResource BoolVisibility}}"
                AutomationProperties.Name="Cards de vagas" />
        </Grid>
        <WrapPanel
            Grid.Row="3"
            Margin="0,16,0,0">
            <Button
                Content="Abrir detalhes"
                Command="{Binding Action}"
                CommandParameter="Open"
                Style="{StaticResource PrimaryButton}" />
            <Button
                Content="Recuperar selecionada"
                Command="{Binding Action}"
                CommandParameter="Recover"
                Visibility="{Binding IsTrash, Converter={StaticResource BoolVisibility}}" />
            <Button
                Content="Arquivar vagas do filtro"
                Command="{Binding Action}"
                CommandParameter="ArchiveFiltered" />
            <Button
                Content="Atualizar"
                Command="{Binding Action}"
                CommandParameter="Refresh" />
        </WrapPanel>
    </Grid>
</UserControl>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:JobTracker.Presentation.ViewModels"
    xmlns:views="clr-namespace:JobTracker.Presentation.Views">
    <DataTemplate
        DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:JobsViewModel}">
        <views:JobsView />
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:BoardViewModel}">
        <views:BoardView />
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:AgendaViewModel}">
        <views:AgendaView />
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:JobEditorViewModel}">
        <views:EditorView />
    </DataTemplate>
</ResourceDictionary>
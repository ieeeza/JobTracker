<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="BarTemplate"><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" Height="14" CornerRadius="7"><Border Background="{DynamicResource AccentBrush}" Width="{Binding Width}" HorizontalAlignment="Left" CornerRadius="7"/></Border><TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right"/></Grid></DataTemplate>
    <DataTemplate x:Key="JobCard"><StackPanel Margin="4"><TextBlock Text="{Binding Content.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Content.Company}" Margin="0,5"/><TextBlock Text="{Binding Content.Technologies}" Style="{StaticResource Muted}"/><WrapPanel Margin="0,8,0,0"><TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0"/><TextBlock Text="{Binding Content.Location}" Style="{StaticResource Muted}"/></WrapPanel></StackPanel></DataTemplate>
    <DataTemplate x:Key="DashboardView"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <ItemsControl ItemsSource="{Binding Dashboard.Metrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <WrapPanel><Border Style="{StaticResource Card}" Width="480"><StackPanel><TextBlock Text="Candidaturas nos últimos 6 meses" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Dashboard.Months}" ItemTemplate="{StaticResource BarTemplate}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="480"><StackPanel><TextBlock Text="Distribuição por status" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Dashboard.Distribution}" ItemTemplate="{StaticResource BarTemplate}"/></StackPanel></Border></WrapPanel>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Atividade recente" Style="{StaticResource Heading}"/><ListBox ItemsSource="{Binding Dashboard.Recent}" SelectedItem="{Binding SelectedJob}" ItemTemplate="{StaticResource JobCard}" MaxHeight="300"/><Button Content="Abrir vaga selecionada" Command="{Binding Action}" CommandParameter="Open" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Próximas ações" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding Dashboard.NextActions}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Content.Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Content.NextAction}" TextWrapping="Wrap"/><TextBlock Text="{Binding Content.NextActionDate, StringFormat=dd/MM/yyyy}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Adicione próximas ações nos detalhes de cada vaga. Sem registros, os indicadores permanecem zerados." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer></DataTemplate>
    <DataTemplate x:Key="JobsView"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16"><WrapPanel>
            <StackPanel Width="170"><TextBlock Text="Empresa"/><TextBox Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar por empresa"/></StackPanel>
            <StackPanel Width="170"><TextBlock Text="Cargo"/><TextBox Text="{Binding RoleFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar por cargo"/></StackPanel>
            <StackPanel Width="150"><TextBlock Text="Tecnologia/tag"/><TextBox Text="{Binding TechnologyFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar por tecnologia"/></StackPanel>
            <StackPanel Width="150"><TextBlock Text="Origem"/><TextBox Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar por origem"/></StackPanel>
            <StackPanel Width="200"><TextBlock Text="Status"/><ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedItem="{Binding StatusFilter}" AutomationProperties.Name="Filtrar por status"/></StackPanel>
            <StackPanel Width="160"><TextBlock Text="Criada a partir de"/><DatePicker SelectedDate="{Binding From}" AutomationProperties.Name="Data inicial"/></StackPanel>
            <StackPanel Width="160"><TextBlock Text="Criada até"/><DatePicker SelectedDate="{Binding To}" AutomationProperties.Name="Data final"/></StackPanel>
            <StackPanel Width="170"><TextBlock Text="Ordenação"/><ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" AutomationProperties.Name="Ordenação"/></StackPanel>
            <Button Content="Limpar filtros" Command="{Binding Action}" CommandParameter="ClearFilters" VerticalAlignment="Bottom"/><CheckBox Content="Visualizar em cards" IsChecked="{Binding Cards}" VerticalAlignment="Bottom"/>
        </WrapPanel></Border>
        <TextBlock Grid.Row="1" Text="{Binding ResultsLabel}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
        <Grid Grid.Row="2"><DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutomationProperties.Name="Lista de vagas"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Style.Triggers><DataTrigger Binding="{Binding Cards}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns>
            <DataGridTextColumn Header="Cargo" Binding="{Binding Content.Title}" Width="2*"/><DataGridTextColumn Header="Empresa" Binding="{Binding Content.Company}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="170"/><DataGridTextColumn Header="Candidatura" Binding="{Binding ApplicationLabel}" Width="120"/><DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="120"/>
        </DataGrid.Columns></DataGrid><ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" ItemTemplate="{StaticResource JobCard}" Visibility="{Binding Cards, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Cards de vagas"/></Grid>
        <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button Content="Abrir detalhes" Command="{Binding Action}" CommandParameter="Open" Style="{StaticResource PrimaryButton}"/><Button Content="Recuperar selecionada" Command="{Binding Action}" CommandParameter="Recover" Visibility="{Binding IsTrash, Converter={StaticResource BoolVisibility}}"/><Button Content="Arquivar vagas do filtro" Command="{Binding Action}" CommandParameter="ArchiveFiltered"/><Button Content="Atualizar" Command="{Binding Action}" CommandParameter="Refresh"/></WrapPanel>
    </Grid></DataTemplate>
    <DataTemplate x:Key="BoardView"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel><TextBlock Text="Mover selecionada para" VerticalAlignment="Center" Margin="0,0,12,12"/><ComboBox Width="210" ItemsSource="{Binding Statuses}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding TargetStatus}"/><Button Content="Alterar status" Command="{Binding Action}" CommandParameter="Status" Style="{StaticResource PrimaryButton}"/><Button Content="Abrir detalhes" Command="{Binding Action}" CommandParameter="Open"/><TextBlock Text="Busca global e filtros da tela Vagas também se aplicam ao quadro." Style="{StaticResource Muted}" VerticalAlignment="Center"/></WrapPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Board}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="270" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Jobs.Count, StringFormat={}{0} vagas}" Style="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding DataContext.SelectedJob, RelativeSource={RelativeSource AncestorType=Window}}" ItemTemplate="{StaticResource JobCard}"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid></DataTemplate>
    <DataTemplate x:Key="AgendaView"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel>
        <StackPanel Width="180"><TextBlock Text="A partir de"/><DatePicker SelectedDate="{Binding AgendaFrom}"/></StackPanel><StackPanel Width="180"><TextBlock Text="Até"/><DatePicker SelectedDate="{Binding AgendaTo}"/></StackPanel><CheckBox Content="Incluir concluídos" IsChecked="{Binding IncludeCompleted}" VerticalAlignment="Center"/>
        </WrapPanel><TextBlock Grid.Row="1" Text="{Binding AgendaLabel}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Agenda}" SelectedItem="{Binding SelectedAppointment}"><DataGrid.Columns><DataGridTextColumn Header="Data e horário local" Binding="{Binding LocalDateTime, StringFormat=dd/MM/yyyy HH:mm}" Width="180"/><DataGridTextColumn Header="Compromisso" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Vaga" Binding="{Binding JobTitle}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="120"/><DataGridCheckBoxColumn Header="Concluído" Binding="{Binding Completed}" Width="100"/></DataGrid.Columns></DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button Content="Concluir compromisso" Command="{Binding Action}" CommandParameter="CompleteAppointment" Style="{StaticResource PrimaryButton}"/><Button Content="Abrir vaga" Command="{Binding Action}" CommandParameter="OpenAppointment"/><TextBlock Text="Agende entrevistas, prazos e follow-ups nos detalhes da vaga." Style="{StaticResource Muted}" VerticalAlignment="Center"/></WrapPanel>
    </Grid></DataTemplate>
    <DataTemplate x:Key="SettingsView"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Inteligência artificial local — Ollama" Style="{StaticResource Heading}"/>
            <TextBlock Text="Instale qwen3-vl:8b no Ollama local. O JobTracker não instala modelos nem inicia o Ollama. As imagens são enviadas somente para este computador." Style="{StaticResource Muted}"/>
            <TextBlock Text="Endereço do servidor local" Margin="0,12,0,0"/>
            <TextBox Text="{Binding Ollama.BaseUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Endereço local do Ollama"/>
            <TextBlock Text="Modelo"/>
            <TextBox Text="{Binding Ollama.Model, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" MaxLength="200" AutomationProperties.Name="Modelo Ollama"/>
            <CheckBox Content="Aguardar o Ollama concluir, sem limite de tempo" IsChecked="{Binding Ollama.WaitForCompletion}"/>
            <CheckBox Content="Economizar memória na análise individual (recomendado para GPU de 8 GB)" IsChecked="{Binding Ollama.PreferLowMemoryIndividualAnalysis}"/>
            <TextBlock Text="Ativado por padrão: processa uma captura por vez, limita o contexto a 4096 tokens e evita repetições com contexto maior. Preserva a resolução original. Capturas muito extensas podem exigir recortes ou desativar esta opção." Style="{StaticResource Muted}"/>
            <TextBlock Text="Você pode cancelar a análise a qualquer momento. Falhas de memória ou encerramento pelo próprio Ollama ainda podem interromper a geração." Style="{StaticResource Muted}"/>
            <TextBlock Text="Tempo limite quando a espera sem limite estiver desmarcada (10 a 3600 segundos; padrão 300)"/>
            <TextBox Text="{Binding Ollama.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="140" HorizontalAlignment="Left"/>
            <TextBlock Text="Manter modelo carregado (0–3600 segundos)"/>
            <TextBox Text="{Binding Ollama.KeepAliveSeconds, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="140" HorizontalAlignment="Left"/>
            <Expander Header="Limites de imagens e memória" Margin="0,8">
                <StackPanel>
                    <TextBlock Text="Contexto inicial em tokens (2048–32768; padrão 8192)"/><TextBox Text="{Binding Ollama.ContextTokens, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Contexto do Ollama em tokens"/>
                    <TextBlock Text="Contexto máximo para expansão automática (até 262144; padrão 32768)"/><TextBox Text="{Binding Ollama.MaxContextTokens, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="Contexto máximo do Ollama em tokens"/>
                    <TextBlock Text="Na análise individual, a expansão só ocorre com a economia de memória desativada. Mais contexto exige mais memória e pode tornar a análise muito mais lenta. Estes valores valem apenas para o JobTracker." Style="{StaticResource Muted}"/>
                    <TextBlock Text="Imagens por lote (1–10; padrão 3)"/><TextBox Text="{Binding Ollama.BatchSize, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/>
                    <TextBlock Text="Máximo de imagens por análise (1–100; padrão 30)"/><TextBox Text="{Binding Ollama.MaxImages, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/>
                    <TextBlock Text="Máximo de MB de imagens por lote (1–64; padrão 24)"/><TextBox Text="{Binding Ollama.BatchMegabytes, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/>
                    <TextBlock Text="Máximo de megapixels por lote (0.01–64; padrão 24; ponto decimal)"/><TextBox Text="{Binding Ollama.BatchMegapixels, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"/>
                    <TextBlock Text="Os lotes são sequenciais. Base64 e processamento do modelo consomem memória adicional. Os limites gerais de importação continuam valendo. Nenhuma imagem é reduzida automaticamente." Style="{StaticResource Muted}"/>
                </StackPanel>
            </Expander>
            <WrapPanel><Button Content="Salvar configuração Ollama" Command="{Binding Action}" CommandParameter="OllamaSave" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Verificar conexão" Command="{Binding Action}" CommandParameter="OllamaVerify"/></WrapPanel>
            <TextBlock Text="{Binding Ollama.ConnectionStatus}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="A verificação usa os valores acima. Salve para usá-los nas próximas análises; o tempo limite não é uma estimativa de duração." Style="{StaticResource Muted}"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Seu espaço de trabalho" Style="{StaticResource Heading}"/><CheckBox Content="Tema escuro" IsChecked="{Binding Dark}"/><CheckBox Content="Reduzir movimento" IsChecked="{Binding ReduceMotion}"/><Button Content="Salvar preferências" Command="{Binding Action}" CommandParameter="SaveSettings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dados locais" Style="{StaticResource Heading}"/><TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap"/><Button Content="Abrir diretório de dados e logs" Command="{Binding Action}" CommandParameter="Folder" HorizontalAlignment="Left" Margin="0,12,0,12"/><TextBlock Text="JSON inclui dados, histórico e agenda para reimportação. CSV é destinado à consulta em planilhas. A importação mostra uma prévia e nunca substitui registros existentes." Style="{StaticResource Muted}" Margin="0,0,0,16"/><WrapPanel><Button Content="Exportar JSON" Command="{Binding Action}" CommandParameter="ExportJson"/><Button Content="Exportar CSV" Command="{Binding Action}" CommandParameter="ExportCsv"/><Button Content="Importar JSON…" Command="{Binding Action}" CommandParameter="Import"/><Button Content="Importar CSV…" Command="{Binding Action}" CommandParameter="ImportCsv"/></WrapPanel><Separator/><TextBlock Text="O backup SQLite inclui vagas e preferências. A restauração verifica o arquivo e guarda uma cópia de segurança dos dados atuais." Style="{StaticResource Muted}" Margin="0,0,0,16"/><WrapPanel><Button Content="Criar backup…" Command="{Binding Action}" CommandParameter="Backup"/><Button Content="Restaurar backup…" Command="{Binding Action}" CommandParameter="Restore"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer></DataTemplate>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JobTracker.Presentation">
<Style x:Key="ImportFeedback" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
 <Setter Property="Margin" Value="0,0,16,10"/>
 <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
</Style>
<DataTemplate x:Key="EditorView"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<local:ImageImportView/>
<StackPanel Visibility="{Binding IsSingleJobForm, Converter={StaticResource BoolVisibility}}">
<TextBlock Text="{Binding ImportMessage}" Style="{StaticResource ImportFeedback}" AutomationProperties.LiveSetting="Polite"/>
<TextBlock Text="{Binding Evidence}" Style="{StaticResource ImportFeedback}"/>
<TextBlock Text="{Binding AnalysisWarnings}" Style="{StaticResource ImportFeedback}"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Informações da vaga" Style="{StaticResource Heading}"/><TextBlock Text="Campos com * são obrigatórios. A captura nunca envia candidaturas." Style="{StaticResource Muted}" Margin="0,0,0,12"/><WrapPanel><StackPanel Width="310"><TextBlock Text="Cargo *"/><TextBox x:Name="JobTitleInput" Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Cargo *"/></StackPanel><StackPanel Width="310"><TextBlock Text="Empresa *"/><TextBox Text="{Binding Editor.Company, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Empresa *"/></StackPanel><StackPanel Width="310"><TextBlock Text="Localização"/><TextBox Text="{Binding Editor.Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Localização"/></StackPanel><StackPanel Width="310"><TextBlock Text="Modalidade"/><TextBox Text="{Binding Editor.WorkMode, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Modalidade"/></StackPanel><StackPanel Width="310"><TextBlock Text="Senioridade"/><TextBox Text="{Binding Editor.Seniority, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Senioridade"/></StackPanel><StackPanel Width="310"><TextBlock Text="Contrato"/><TextBox Text="{Binding Editor.Contract, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Contrato"/></StackPanel><StackPanel Width="310"><TextBlock Text="Remuneração informada"/><TextBox Text="{Binding Editor.Salary, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Remuneração informada"/></StackPanel><StackPanel Width="310"><TextBlock Text="Tecnologias / tags (separadas por vírgulas)"/><TextBox Text="{Binding Editor.Technologies, UpdateSourceTrigger=PropertyChanged}" MaxLength="8000" AutomationProperties.Name="Tecnologias / tags (separadas por vírgulas)"/></StackPanel></WrapPanel><StackPanel>
<TextBlock Text="Link de referência (opcional, não é acessado pela análise)"/>
<TextBox Text="{Binding Editor.Url, UpdateSourceTrigger=PropertyChanged}" MaxLength="8000" AutomationProperties.Name="Link de referência"/>
</StackPanel><TextBlock Text="Descrição completa"/><TextBox Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="180" MaxLength="200000" AutomationProperties.Name="Descrição completa"/><TextBlock Text="Requisitos"/><TextBox Text="{Binding Editor.Requirements, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="110" MaxLength="50000" AutomationProperties.Name="Requisitos"/><TextBlock Text="Notas pessoais"/><TextBox Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="110" MaxLength="50000" AutomationProperties.Name="Notas pessoais"/></StackPanel></Border><Border Style="{StaticResource Card}">   <Expander Header="Candidaturas já registradas" IsExpanded="True">
    <StackPanel Margin="0,8">
     <TextBlock Text="{Binding DuplicateSummary}" TextWrapping="Wrap"/>
     <ListBox ItemsSource="{Binding DuplicateMatches}" SelectedItem="{Binding SelectedDuplicate}" MaxHeight="200" Margin="0,8">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="4"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel>
      <Button Content="Verificar correspondências" Command="{Binding Action}" CommandParameter="CheckDuplicates"/>
      <Button Content="Abrir histórico selecionado" Command="{Binding Action}" CommandParameter="OpenDuplicate"/>
     </WrapPanel>
    </StackPanel>
   </Expander></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Acompanhamento da candidatura" Style="{StaticResource Heading}"/><WrapPanel>
<StackPanel Width="260"><TextBlock Text="Status"/><ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Editor.Status}" AutomationProperties.Name="Status da candidatura"/></StackPanel>
<StackPanel Width="190"><TextBlock Text="Data da candidatura"/><DatePicker SelectedDate="{Binding Editor.ApplicationDate}" AutomationProperties.Name="Data da candidatura"/></StackPanel>
<StackPanel Width="240"><TextBlock Text="Canal"/><TextBox Text="{Binding Editor.Channel}" MaxLength="500" AutomationProperties.Name="Canal"/></StackPanel></WrapPanel>
<WrapPanel><StackPanel Width="500"><TextBlock Text="Próxima ação / follow-up"/><TextBox Text="{Binding Editor.NextAction}" MaxLength="500" AutomationProperties.Name="Próxima ação"/></StackPanel><StackPanel Width="190"><TextBlock Text="Data da próxima ação"/><DatePicker SelectedDate="{Binding Editor.NextActionDate}"/></StackPanel></WrapPanel>
<TextBlock Text="Mudar de Salva para uma etapa de candidatura registra o envio. Nenhuma candidatura é enviada automaticamente. Para candidaturas já registradas, a data original é preservada." Style="{StaticResource Muted}"/>
<WrapPanel Margin="0,16,0,0"><Button Content="_Salvar vaga" Command="{Binding Action}" CommandParameter="Save" Style="{StaticResource PrimaryButton}"/><Button Content="Copiar dados" Command="{Binding Action}" CommandParameter="Copy"/><Button Content="Copiar URL" Command="{Binding Action}" CommandParameter="CopyUrl"/><Button Content="Mover para lixeira…" Command="{Binding Action}" CommandParameter="Delete" Visibility="{Binding IsExisting, Converter={StaticResource BoolVisibility}}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}" Visibility="{Binding IsExisting, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Agendar entrevista ou lembrete" Style="{StaticResource Heading}"/><WrapPanel>
<StackPanel Width="300"><TextBlock Text="Título"/><TextBox Text="{Binding AppointmentTitle}" MaxLength="200"/></StackPanel><StackPanel Width="180"><TextBlock Text="Data local"/><DatePicker SelectedDate="{Binding AppointmentDate}"/></StackPanel><StackPanel Width="130"><TextBlock Text="Horário (HH:mm)"/><TextBox Text="{Binding AppointmentTime}" MaxLength="5"/></StackPanel><StackPanel Width="200"><TextBlock Text="Tipo"/><TextBox Text="{Binding AppointmentKind}" MaxLength="100"/></StackPanel></WrapPanel><TextBlock Text="Observações"/><TextBox Text="{Binding AppointmentNotes}" MaxLength="10000"/><Button Content="Adicionar à agenda" Command="{Binding Action}" CommandParameter="Schedule" HorizontalAlignment="Left"/>
<ItemsControl ItemsSource="{Binding JobAppointments}"><ItemsControl.ItemTemplate><DataTemplate><WrapPanel Margin="0,5"><TextBlock Text="{Binding LocalDateTime, StringFormat=dd/MM/yyyy HH:mm}" Margin="0,0,16,0"/><TextBlock Text="{Binding Title}" Margin="0,0,16,0"/><CheckBox Content="Concluído" IsChecked="{Binding Completed, Mode=OneWay}" IsEnabled="False"/></WrapPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></Border><Border Style="{StaticResource Card}" Visibility="{Binding IsExisting, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Histórico de alterações" Style="{StaticResource Heading}"/><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
</StackPanel></StackPanel></ScrollViewer></DataTemplate></ResourceDictionary>

<Window x:Class="JobTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:vm="clr-namespace:JobTracker.Presentation.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="JobTracker — Seu próximo passo" Width="1360" Height="900" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" Language="pt-BR">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.NewJob}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#15233D">
            <DockPanel Margin="12,24">
                <StackPanel DockPanel.Dock="Top" Margin="16,0,0,28">
                    <TextBlock Text="JOBTRACKER" Foreground="White" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Seu próximo passo." Foreground="#A8B9D7" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="14">
                    <TextBlock Text="LOCAL E PRIVADO" Foreground="#A8B9D7" FontSize="11"/>
                    <TextBlock Text="Sem contas. Sem assinaturas." Foreground="#DCE7FA" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="Ctrl+N • Nova vaga&#x0a;Ctrl+S • Salvar formulário&#x0a;F5 • Atualizar" Foreground="#A8B9D7" FontSize="11" Margin="0,14,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Button Content="◷   Dashboard" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.Dashboard}"/>
                    <Button Content="▤   Vagas" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.Jobs}"/>
                    <Button Content="＋   Nova vaga" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.NewJob}"/>
                    <Button Content="▥   Candidaturas" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.Board}"/>
                    <Button Content="▦   Agenda" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.Agenda}"/>
                    <Button Content="⚙   Configurações" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.Settings}"/>
                    <Button Content="♧   Lixeira" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.Trash}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="＋ Nova vaga" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.NewJob}" Style="{StaticResource PrimaryButton}"/>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Muted}" Margin="0,6,20,0"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Jobs.Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" AutomationProperties.Name="Busca global por empresa, cargo, descrição ou tecnologia" ToolTip="Buscar por empresa, cargo, descrição ou tecnologia" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="Buscar nas vagas" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageDestination.Jobs}" Margin="0"/>
            </Grid>
            <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" IsEnabled="{Binding Operations.IsIdle}"/>
            <Border Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding Operations.IsBusy, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding Operations.Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding Operations.CancelLabel}" Command="{Binding CancelCommand}" Margin="12,0,0,0" Visibility="{Binding Operations.IsBusy, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

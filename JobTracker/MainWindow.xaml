<Window x:Class="JobTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="JobTracker — Seu próximo passo" Width="1360" Height="900" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" Language="pt-BR">
    <Window.InputBindings><KeyBinding Key="N" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Nova vaga"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding Action}" CommandParameter="Save"/><KeyBinding Key="F5" Command="{Binding Action}" CommandParameter="Refresh"/></Window.InputBindings>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#15233D"><DockPanel Margin="12,24"><StackPanel DockPanel.Dock="Top" Margin="16,0,0,28"><TextBlock Text="JOBTRACKER" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="Seu próximo passo." Foreground="#A8B9D7" Margin="0,6,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="14"><TextBlock Text="LOCAL E PRIVADO" Foreground="#A8B9D7" FontSize="11"/><TextBlock Text="Sem contas. Sem assinaturas." Foreground="#DCE7FA" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Ctrl+N • Nova vaga&#x0a;Ctrl+S • Salvar formulário&#x0a;F5 • Atualizar" Foreground="#A8B9D7" FontSize="11" Margin="0,14,0,0"/></StackPanel>
        <StackPanel><Button Content="◷   Dashboard" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="Dashboard"/><Button Content="▤   Vagas" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="Vagas"/><Button Content="＋   Nova vaga" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="Nova vaga"/><Button Content="▥   Candidaturas" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="Candidaturas"/><Button Content="▦   Agenda" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="Agenda"/><Button Content="⚙   Configurações" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="Configurações"/><Button Content="♧   Lixeira" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="Lixeira"/></StackPanel></DockPanel></Border>
        <Grid Grid.Column="1" Margin="28,24,20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="＋ Nova vaga" Command="{Binding Navigate}" CommandParameter="Nova vaga" Style="{StaticResource PrimaryButton}"/><StackPanel><TextBlock Text="{Binding Page}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding PageDescription}" Style="{StaticResource Muted}" Margin="0,6,20,0"/></StackPanel></DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" AutomationProperties.Name="Busca global por empresa, cargo, descrição ou tecnologia" ToolTip="Buscar por empresa, cargo, descrição ou tecnologia" Margin="0,0,12,0"/><Button Grid.Column="1" Content="Buscar nas vagas" Command="{Binding Navigate}" CommandParameter="Vagas" Margin="0"/></Grid>
        <ContentControl Grid.Row="2" Content="{Binding}" IsEnabled="{Binding IsIdle}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource DashboardView}"/><Style.Triggers>
            <DataTrigger Binding="{Binding Page}" Value="Vagas"><Setter Property="ContentTemplate" Value="{StaticResource JobsView}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="Lixeira"><Setter Property="ContentTemplate" Value="{StaticResource JobsView}"/></DataTrigger>
            <DataTrigger Binding="{Binding Page}" Value="Nova vaga"><Setter Property="ContentTemplate" Value="{StaticResource EditorView}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="Detalhes"><Setter Property="ContentTemplate" Value="{StaticResource EditorView}"/></DataTrigger>
            <DataTrigger Binding="{Binding Page}" Value="Candidaturas"><Setter Property="ContentTemplate" Value="{StaticResource BoardView}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="Agenda"><Setter Property="ContentTemplate" Value="{StaticResource AgendaView}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="Configurações"><Setter Property="ContentTemplate" Value="{StaticResource SettingsView}"/></DataTrigger>
        </Style.Triggers></Style></ContentControl.Style></ContentControl>
        <Border Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel><Button Grid.Column="1" Content="{Binding CancelLabel}" Command="{Binding Cancel}" Margin="12,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/></Grid></Border>
        </Grid>
    </Grid>
</Window>

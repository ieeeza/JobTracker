<Window
    x:Class="JobTracker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:vm="clr-namespace:JobTracker.Presentation.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource {x:Type Window}}"
    Title="JobTracker — Seu próximo passo"
    Width="1360"
    Height="900"
    MinWidth="980"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Language="pt-BR"
    xmlns:views="clr-namespace:JobTracker.Presentation.Views">
    <Window.InputBindings>
        <KeyBinding
            Key="N"
            Modifiers="Control"
            Command="{Binding NavigateCommand}"
            CommandParameter="{x:Static vm:PageDestination.NewJob}" />
        <KeyBinding
            Key="S"
            Modifiers="Control"
            Command="{Binding SaveCommand}" />
        <KeyBinding
            Key="F5"
            Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <views:ShellView />
</Window>